# ==============================================================================
# SolarFlow Engineering SaaS Platform - Environment Variables Template
# ==============================================================================
# Copy this template to .env or .env.local and populate with environment values.
# DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL.

# Backend HTTP Server Port
PORT=8080

# Production CORS Security Policy (comma-separated list of allowed frontend origins)
CORS_ORIGINS=https://frontend-umber-zeta-rvr2p5t2aa.vercel.app,http://localhost:3000,http://localhost:5173

# Database Connection (Google Cloud SQL PostgreSQL 15)
DB_USER=postgres
DB_PASS=YOUR_SECURE_POSTGRES_PASSWORD_HERE
DB_NAME=solarflow_db
DB_HOST=127.0.0.1
DB_PORT=5432

# Google Cloud Run / Cloud SQL Unix Socket Connection Name (Optional for local TCP)
INSTANCE_CONNECTION_NAME=solarbot-v0:us-central1:solarflow-postgres

# JWT Authentication & Cryptographic Signing Secret
JWT_SECRET_KEY=YOUR_HMAC_SHA256_SECRET_KEY_MIN_32_CHARS_HERE

# Google Maps & Google Solar API Key
GOOGLE_MAPS_API_KEY=YOUR_RESTRICTED_GOOGLE_SOLAR_API_KEY_HERE

# Frontend Environment Variables (React / Vite / Vercel)
VITE_API_URL=https://solarflow-backend-gbzl7cxmxq-uc.a.run.app/api
VITE_API_BASE_URL=https://solarflow-backend-gbzl7cxmxq-uc.a.run.app
