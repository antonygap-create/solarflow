# =====================================================================
# SolarFlow Backend Environment Configuration Example
# =====================================================================

# Environment Mode ('development', 'staging', 'production')
ENV=production
TESTING=false

# Database Configuration (PostgreSQL / Cloud SQL)
DB_USER=postgres
DB_PASS=YOUR_SECURE_POSTGRES_PASSWORD_HERE
DB_NAME=solarflow_db
DB_HOST=127.0.0.1
DB_PORT=5432

# Cloud SQL Unix Socket (Cloud Run Native)
# INSTANCE_CONNECTION_NAME=project-id:region:instance-name
# DB_SOCKET_DIR=/cloudsql

# JWT Authentication (Generate via: openssl rand -hex 32)
JWT_SECRET_KEY=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_KEY_32_BYTES

# Google Cloud Maps Solar API Key
GOOGLE_SOLAR_API_KEY=YOUR_GOOGLE_CLOUD_SOLAR_API_KEY_HERE

# Production Restricted CORS Origins (comma separated, no wildcards)
CORS_ORIGINS=https://solarflow-app.run.app,http://localhost:3000,http://localhost:5173

# Serverless Connection Pool Tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
